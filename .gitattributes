# Legacy test fixtures: byte-exact round-trip tests depend on these files never
# being renormalised by git on any platform.
legacy/samples/** -text -diff

# The phase 4 validation baseline (see BASELINE.md) is a captured run of the
# original Delphi application. Regenerating any of it means running that app on
# Windows, so it must never be rewritten by git.
data/baseline/** -text -diff

# Delphi build outputs and resources are binary.
*.dcu binary
*.dfm binary
*.exe binary
*.res binary
*.dcr binary
*.ico binary
*.bmp binary
*.hlp binary
*.doc binary
