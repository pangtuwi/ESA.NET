<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Layering rule: App.Core must never reference a UI framework. There are no
    PackageReferences here by design, and LayeringTests enforces it at test time.
  -->
  <PropertyGroup>
    <RootNamespace>App.Core</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
    <!-- The coefficient tables are implementation detail, but they are worth pinning
         against the Delphi declarations they were transcribed from. -->
    <InternalsVisibleTo Include="App.Tests" />
  </ItemGroup>

</Project>
